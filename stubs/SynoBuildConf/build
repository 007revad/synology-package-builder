#!/bin/bash
# Copyright (c) 2000-2022 Synology Inc. All rights reserved.

# Variable definitions:
# - BuildingProj
# - SYNO_PLATFORM=AVOTON
# - ARCH=x86_64
# - OUTPUT
# - STUBS

case ${MakeClean} in
[Yy][Ee][Ss])
    make clean
    ;;
esac

make ${MAKE_FLAGS}

#---------------------------------------------------------------------
# Setuid helper(s): any *.c file under ./helper/ gets compiled with
# this chroot's own gcc - EnvDeploy already put the correct
# cross-compiler for $ARCH on PATH, so no cross flags are needed here.
# Optional: packages with no ./helper/ are untouched by this block.
#---------------------------------------------------------------------
HELPER_DIR="./helper"
TARGET_DIR="./target/bin/helper"

if [ -d "$HELPER_DIR" ]; then
    found=0
    for src in "$HELPER_DIR"/*.c; do
        test -f "$src" || continue
        found=1

        name=$(basename "$src" .c)
        out="$TARGET_DIR/$name"

        echo "→ Compiling $src -> $out ($ARCH)" >&2
        mkdir -p "$TARGET_DIR"

        # Prefer a triplet-prefixed cross-compiler if this chroot has one
        # (ARM/i686 platforms keep theirs under /usr/local/<triplet>/bin,
        # off the default PATH); fall back to plain gcc for platforms -
        # like kvmx64 - where the host gcc already targets the right arch.
        # NOTE: vendor field in the triplet varies by toolchain
        # (arm-unknown-linux-gnueabi vs i686-pc-linux-gnu), so match on
        # "-linux-gnu" rather than a specific vendor string.
        CC="gcc"
        for candidate in /usr/local/*-linux-gnu*/bin/*-gcc; do
            test -x "$candidate" || continue
            CC="$candidate"
            break
        done

        # Verify $CC's reported target actually matches $ARCH before
        # trusting it - a wrong-arch gcc will happily produce a
        # -static binary that "succeeds" here and only fails at
        # runtime on real hardware with Exec format error.
        cc_machine=$("$CC" -dumpmachine 2>/dev/null) || {
            echo "ERROR: '$CC' -dumpmachine failed" >&2
            exit 1
        }
        case "$cc_machine" in
            *"$ARCH"*) : ;;
            *)
                echo "ERROR: selected compiler '$CC' targets '$cc_machine'," \
                     "which doesn't look like it matches ARCH='$ARCH'." \
                     "Refusing to compile with a possibly wrong-arch compiler." >&2
                exit 1
                ;;
        esac

        echo "→ Compiling $src -> $out ($ARCH) using $CC ($cc_machine)" >&2
        mkdir -p "$TARGET_DIR"

        "$CC" -O2 -static -Wall -Wextra -std=gnu99 -o "$out" "$src" || {
            echo "ERROR: failed to compile $src" >&2
            exit 1
        }

        chmod 0755 "$out"
    done
    [ "$found" -eq 1 ] || echo "→ $HELPER_DIR exists but contains no .c files, skipping" >&2
fi
