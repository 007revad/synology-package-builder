#!/bin/bash
# Copyright (c) 2000-2022 Synology Inc. All rights reserved.

# Variable definitions:
# - BuildingProj
# - SYNO_PLATFORM=AVOTON
# - ARCH=x86_64
# - OUTPUT
# - STUBS

case ${MakeClean} in
[Yy][Ee][Ss])
    make clean
    ;;
esac

make ${MAKE_FLAGS}

#---------------------------------------------------------------------
# Setuid helper(s): any *.c file under ./helper/ gets compiled with
# this chroot's own gcc - EnvDeploy already put the correct
# cross-compiler for $ARCH on PATH, so no cross flags are needed here.
# Optional: packages with no ./helper/ are untouched by this block.
#---------------------------------------------------------------------
HELPER_DIR="./helper"
TARGET_DIR="./target/bin/helper"

if [ -d "$HELPER_DIR" ]; then
    found=0
    for src in "$HELPER_DIR"/*.c; do
        test -f "$src" || continue
        found=1

        name=$(basename "$src" .c)
        out="$TARGET_DIR/$name"

        echo "→ Compiling $src -> $out ($ARCH)" >&2
        mkdir -p "$TARGET_DIR"

        # Synology's own $ARCH values (arm, arm64, x86, x86_64, ...) don't
        # match GNU triplet naming (arm-unknown-linux-gnueabi,
        # aarch64-unknown-linux-gnu, i686-pc-linux-gnu, ...), so map
        # explicitly rather than substring-matching $ARCH against a
        # -dumpmachine string. This also scopes the search to only the
        # toolchain expected for this arch - important because multiple
        # cross-toolchains have been observed coexisting under /usr/local
        # in the same build container (likely from toolkit pre-caching),
        # so an unscoped glob can silently pick up the wrong one.
        case "$ARCH" in
            x86_64) triplet_glob='x86_64-*linux-gnu*' ;;
            arm64)  triplet_glob='aarch64-*linux-gnu*' ;;
            arm)    triplet_glob='arm-*linux-gnu*' ;;
            x86)    triplet_glob='i686-*linux-gnu*' ;;
            *)
                echo "ERROR: no known cross-compiler triplet mapping for" \
                     "ARCH='$ARCH'. Add a case for it before building" \
                     "this arch." >&2
                exit 1
                ;;
        esac

        # Prefer the triplet-prefixed cross-compiler matching this arch
        # (ARM/i686 platforms keep theirs under /usr/local/<triplet>/bin,
        # off the default PATH); fall back to plain gcc only if no
        # matching triplet dir exists (e.g. kvmx64, where the build
        # host's own gcc already targets x86_64).
        CC="gcc"
        for candidate in /usr/local/${triplet_glob}/bin/*-gcc; do
            test -x "$candidate" || continue
            CC="$candidate"
            break
        done

        # Verify $CC's reported target actually matches the expected
        # triplet pattern before trusting it - a wrong-arch gcc will
        # happily produce a -static binary that "succeeds" here and
        # only fails at runtime on real hardware with Exec format error.
        cc_machine=$("$CC" -dumpmachine 2>/dev/null) || {
            echo "ERROR: '$CC' -dumpmachine failed" >&2
            exit 1
        }
        case "$cc_machine" in
            $triplet_glob) : ;;
            *)
                echo "ERROR: selected compiler '$CC' targets '$cc_machine'," \
                     "which doesn't match expected pattern '$triplet_glob'" \
                     "for ARCH='$ARCH'. Refusing to compile with a" \
                     "possibly wrong-arch compiler." >&2
                exit 1
                ;;
        esac

        echo "→ Compiling $src -> $out ($ARCH) using $CC ($cc_machine)" >&2
        mkdir -p "$TARGET_DIR"

        "$CC" -O2 -static -Wall -Wextra -std=gnu99 -o "$out" "$src" || {
            echo "ERROR: failed to compile $src" >&2
            exit 1
        }

        chmod 0755 "$out"
    done
    [ "$found" -eq 1 ] || echo "→ $HELPER_DIR exists but contains no .c files, skipping" >&2
fi
